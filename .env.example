# Copy to .env (chmod 600) and fill in. install.sh's LaunchAgent wrapper
# loads it; config.yaml names them in mqtt.username_env / mqtt.password_env.
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Optional: file uncaught exceptions as GitHub issues
# (python-github-error-reporter). Reporting is off unless both are set.
GITHUB_ERROR_TOKEN=
GITHUB_REPO=
GITHUB_ERROR_ENVIRONMENT=production
